{
  "name": "kiss-translator",
  "description": "A minimalist bilingual translation Extension & Greasemonkey Script",
  "version": "2.1.0",
  "author": "Gabe<yugang2002@gmail.com>",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "^5.18.0",
    "@streamparser/json": "^0.0.22",
    "dompurify": "^3.4.16",
    "postcss-selector-parser": "6.1.3",
    "query-string": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^8.0.7",
    "sval": "^0.5.9",
    "webdav": "^5.11.0",
    "webextension-polyfill": "^0.10.0",
    "react-router": "7.18.4"
  },
  "scripts": {
    "start": "cross-env HOST=127.0.0.1 REACT_APP_CLIENT=web react-app-rewired start",
    "start:userscript": "cross-env HOST=127.0.0.1 REACT_APP_CLIENT=userscript react-app-rewired start",
    "sync-version": "zx src/scripts/sync-version.mjs",
    "version:patch": "zx src/scripts/update-version.mjs patch",
    "version:minor": "zx src/scripts/update-version.mjs minor",
    "version:major": "zx src/scripts/update-version.mjs major",
    "version:set": "zx src/scripts/update-version.mjs set",
    "build:chrome": "zx src/scripts/build-task.mjs --target=chrome",
    "build:edge": "zx src/scripts/build-task.mjs --target=edge",
    "build:safari-output": "zx src/scripts/build-task.mjs --target=safari",
    "build:thunderbird": "zx src/scripts/build-task.mjs --target=thunderbird",
    "build:firefox": "zx src/scripts/build-task.mjs --target=firefox",
    "build:web": "zx src/scripts/build-task.mjs --target=web",
    "build:safari": "node src/scripts/build-safari.mjs",
    "build:userscript-ios": "zx src/scripts/build-ios.mjs",
    "build:rules": "babel-node src/rules.js",
    "format": "prettier --write \"**/*.{js,json,html}\"",
    "build": "pnpm sync-version && pnpm format && pnpm build:chrome && pnpm build:edge && pnpm build:thunderbird && pnpm build:firefox && pnpm build:web && pnpm build:userscript-ios && pnpm build:rules",
    "zip": "zx src/scripts/archive.mjs",
    "build+zip": "cross-env CI=true pnpm build && pnpm zip",
    "test": "react-app-rewired test",
    "test:subtitle-segmentation": "babel-node src/scripts/test-subtitle-segmentation.js",
    "test:terms": "babel-node src/scripts/test-term-replace.js",
    "eject": "react-scripts eject",
    "audit:dependencies": "node src/scripts/audit-dependencies.mjs",
    "test:dependency-compatibility": "node src/scripts/test-charlie-dependencies.mjs",
    "test:charlie": "react-app-rewired test --runInBand --watchAll=false src/libs/securityGuard.test.js src/libs/clipboard.test.js src/libs/inputTranslate.test.js src/apis/trans.mtran.test.js src/config/api.test.js src/config/setting.test.js src/libs/storage.test.js src/libs/sync.test.js src/libs/translatorManager.test.js src/views/Options/Apis.test.js src/views/Options/index.test.js src/views/Options/Navigator.test.js src/views/Popup/index.test.js src/views/Options/Layout.test.js src/views/Options/startup.integration.test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "globals": {
      "GM": true,
      "unsafeWindow": true,
      "globalThis": true,
      "messenger": true,
      "LanguageDetector": true,
      "Translator": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.29.7",
    "bestzip": "^2.2.7",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "find-up": "^7.0.0",
    "prettier": "3.6.2",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1",
    "zx": "^8.8.5"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.9.0",
      "websocket-driver": "0.7.5",
      "nth-check@<2.0.1": "2.1.1",
      "postcss@<8.5.23": "8.5.23",
      "minimatch@<4": "3.1.4",
      "minimatch@>=5 <6": "5.1.8",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "ajv@<7": "6.14.0",
      "ajv@>=7 <9": "8.20.0",
      "rollup@<3": "2.80.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "yaml@<2": "1.10.3",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "jsonpath": "1.3.0",
      "qs": "6.16.0",
      "path-to-regexp@<1": "0.1.13",
      "node-forge": "1.4.0",
      "lodash": "4.18.1",
      "fast-uri@>=3 <4": "3.1.8",
      "nanoid@<4": "3.3.18",
      "decode-uri-component": "0.5.0",
      "serialize-javascript": "7.0.5",
      "underscore": "1.13.8",
      "@tootallnate/once": "2.0.1"
    }
  },
  "packageManager": "pnpm@10.15.1"
}
